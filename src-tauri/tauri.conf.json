{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFTools",
  "version": "1.0.3",
  "identifier": "com.bearben.pdftools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDFTools - 智能发票合并打印与效率工具箱",
        "width": 1320,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
